# MusicBrainz asks every client to identify itself with contact details. Without this they
# throttle you hard and answer 503. An email address or a project URL both work.
MUSICBRAINZ_CONTACT=you@example.com

# Songstats — Spotify monthly listeners. Get this from Evan at Songstats.
# Billed per unique artist per calendar month, so repeat lookups of the same artist are free.
SONGSTATS_API_KEY=
